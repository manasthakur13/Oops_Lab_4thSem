#include <iostream>
using namespace std;

// 1. SINGLE INHERITANCE
class Animal{
public:
    void eat(){
        cout << "Animal is eating." << endl;
    }
};
class Dog : public Animal{
public:
    void bark(){
        cout << "Dog is barking." << endl;
    }
};

// 2. MULTILEVEL INHERITANCE
class Person{
public:
    void breathe(){
        cout << "Person is breathing." << endl;
    }
};
class Employee : public Person{
public:
    void work(){
        cout << "Employee is working." << endl;
    }
};
class Manager : public Employee{
public:
    void manage(){
        cout << "Manager is managing the team." << endl;
    }
};

// 3. MULTIPLE INHERITANCE
class Printer{
public:
    void printDocument(){
        cout << "Printer is printing." << endl;
    }
};
class Scanner{
public:
    void scanDocument(){
        cout << "Scanner is scanning." << endl;
    }
};
// Copier inherits from both Printer and Scanner
class Copier : public Printer, public Scanner{
public:
    void copyDocument(){
        cout << "Copier is copying." << endl;
    }
};

// 4. HIERARCHICAL INHERITANCE
class Shape{
public:
    void drawShape(){
        cout << "Drawing a generic shape." << endl;
    }
};
class Circle : public Shape{
public:
    void drawCircle(){
        cout << "Drawing a Circle." << endl;
    }
};
class Rectangle : public Shape{
public:
    void drawRectangle(){
        cout << "Drawing a Rectangle." << endl;
    }
};

// 5. HYBRID INHERITANCE
// A mix of two or more types of inheritance.
class Vehicle{
public:
    void startVehicle(){
        cout << "Vehicle started." << endl;
    }
};
// Using 'virtual' so AmphibiousVehicle gets only ONE copy of Vehicle
class Car : virtual public Vehicle{
public:
    void drive(){
        cout << "Car is driving on roads." << endl;
    }
};
class Boat : virtual public Vehicle{
public:
    void sail(){
        cout << "Boat is sailing on water." << endl;
    }
};
// Inherits from Car & Boat,which both inherit from Vehicle
class AmphibiousVehicle : public Car, public Boat{
public:
    void switchMode(){
        cout << "Amphibious Vehicle switching modes." << endl;
    }
};

int main(){
    cout << "--- 1. Single Inheritance ---" << endl;
    Dog myDog;
    myDog.eat();  // From Base
    myDog.bark(); // From Derived
    cout << endl;
    cout << "--- 2. Multilevel Inheritance ---" << endl;
    Manager myManager;
    myManager.breathe(); // From Grandparent
    myManager.work();    // From Parent
    myManager.manage();  // From Child
    cout << endl;
    cout << "--- 3. Multiple Inheritance ---" << endl;
    Copier myCopier;
    myCopier.printDocument(); // From Base 1
    myCopier.scanDocument();  // From Base 2
    myCopier.copyDocument();  // From Derived
    cout << endl;
    cout << "--- 4. Hierarchical Inheritance ---" << endl;
    Circle myCircle;
    Rectangle myRect;
    myCircle.drawShape();  // From Common Base
    myCircle.drawCircle(); // From Derived 1
    myRect.drawShape();    // From Common Base
    myRect.drawRectangle();// From Derived 2
    cout << endl;
    cout << "--- 5. Hybrid Inheritance ---" << endl;
    AmphibiousVehicle myAmphi;
    myAmphi.startVehicle(); // From Top Base
    myAmphi.drive();        // From Left Base
    myAmphi.sail();         // From Right Base
    myAmphi.switchMode();   // From Bottom Derived
    cout << endl;
    return 0;
}
