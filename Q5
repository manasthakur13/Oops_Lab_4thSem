#include <iostream>
using namespace std;

class Student{
    int roll;
    float marks;
public:
    Student(){
        roll = 0;
        marks = 0.0;
    }
    Student(int r, float m){
        roll = r;
        marks = m;
    }
    Student(int r){
        roll = r;
        marks = 40.0;
    }
    Student(const Student &s){
        roll = s.roll;
        marks = s.marks;
    }
    void display(){
        cout << "Roll: " << roll << " | Marks: " << marks << endl;
    }
};

int main(){
    Student s1;
    Student s2(101, 88.5);
    Student s3(105);
    Student s4 = s2;
    cout << "Default Constructor: ";
    s1.display();
    cout << "Parameterized Constructor: ";
    s2.display();
    cout << "Overloaded Constructor: ";
    s3.display();
    cout << "Copy Constructor: ";
    s4.display();
    return 0;
}
