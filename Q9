#include <iostream>
using namespace std;

class Base{
public:
    virtual void display(){
        cout << "Displaying Base class" << endl;
    }
    void show(){
        cout << "Showing Base class" << endl;
    }
};

class Derived : public Base{
public:
    void display(){
        cout << "Displaying Derived class" << endl;
    }
    void show(){
        cout << "Showing Derived class" << endl;
    }
};

int main(){
    Base *ptr;
    Base b;
    Derived d;
    ptr = &b;
    ptr->display(); // Calls Base
    ptr->show();    // Calls Base
    ptr = &d;
    ptr->display(); // Calls Derived (Runtime Polymorphism)
    ptr->show();    // Calls Base (Static Binding)
    return 0;
}
