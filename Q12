#include <iostream>
using namespace std;

const double EXCHANGE_RATE = 83.50; //1 USD = 83.50 INR

class INR;
class USD{
    double amount;
public:
    USD(double amt = 0.0){ amount = amt; }
    double getAmount() const{ return amount; }
    //Cast USD to INR
    operator INR() const; 
};

class INR{
    double amount;
public:
    INR(double amt = 0.0){ amount = amt; }
    double getAmount() const { return amount; }
    //Cast INR to USD
    operator USD() const{
        return USD(amount / EXCHANGE_RATE);
    }
};

USD::operator INR() const{
    return INR(amount * EXCHANGE_RATE);
}

int main() {
    int choice;
    double inputAmount;
    // Format output to 2 decimal places
    cout.setf(ios::fixed);
    cout.precision(2);
    do{
        cout << "\n===================================" << endl;
        cout << "    CURRENCY CONVERTER" << endl;
        cout << "===================================" << endl;
        cout << "1. Convert USD to INR" << endl;
        cout << "2. Convert INR to USD" << endl;
        cout << "3. Exit" << endl;
        cout << "-----------------------------------" << endl;
        cout << "Enter your choice (1-3): ";
        cin >> choice;
        if (choice == 3){
            cout << "Exiting program. Goodbye!" << endl;
            break;
        }
        switch (choice){
            case 1:{
                cout << "Enter amount in USD: ";
                cin >> inputAmount;
                USD myUsd(inputAmount);
                //class conversion
                INR convertedToInr = myUsd;
                cout << myUsd.getAmount() << " USD = "<< convertedToInr.getAmount() << " INR" << endl;
                break;
            }
            case 2:{
                cout << "Enter amount in INR: ";
                cin >> inputAmount;
                INR myInr(inputAmount);
                // class conversion
                USD convertedToUsd = myInr;
                cout << myInr.getAmount() << " INR = "<< convertedToUsd.getAmount() << " USD" << endl;
                break;
            }
            default:
                cout << "Invalid choice! Please select an option from 1 to 3." << endl;
        }
    } while(choice != 3);
    return 0;
}
